    using System;
    using System.Collections.Generic;
    using System.Linq;
    using System.Text;
    using System.Threading.Tasks;

    namespace Program52
    {
    internal class Program
    {
        static void Main()
        {
            Console.Write("Возраст: ");
            if (int.TryParse(Console.ReadLine(), out int age) && age >= 0)
            {
                string category;
                if (age <= 12) category = "Ребенок";
                else if (age <= 17) category = "Подросток";
                else if (age <= 64) category = "Взрослый";
                else category = "Пожилой";

                Console.WriteLine(category);
            }
            else
            {
                Console.WriteLine("Ошибка: возраст должен быть неотрицательным числом.");
            }
        }
    }
    }
